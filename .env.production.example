# Production build inputs. Copy to `.env.production` (gitignored) or set these
# in your CI/build environment. See DEPLOYMENT.md.
#
# Vite reads `.env.production` automatically for `vite build` (mode=production).
# Shell values win over this file, which is what CI should use:
#   VITE_API_URL=https://api-nucleus.raghuenggcollege.com npm run build

# REQUIRED. The API origin, no trailing slash. The build FAILS without it.
#
# The dev fallback is the relative `/api`, which only works behind the Vite
# dev-server proxy. On a static host it hits the SPA catch-all rewrite and
# returns 200 + HTML, so the connectivity monitor reports the server healthy
# while every call fails — a silent, self-masking outage. Hence the build guard.
VITE_API_URL=https://api-nucleus.raghuenggcollege.com

# Google OIDC client id for the admin login page. Must be identical to
# GOOGLE_ADMIN_OIDC_CLIENT_ID in nucleus-server. Unset, the "Continue with
# Google" button is hidden. The admin origin must also be listed as an
# authorized JavaScript origin on this client in Google Cloud Console.
VITE_GOOGLE_OIDC_CLIENT_ID=

# Origin serving presigned S3 URLs — the admin app renders student photos and
# company logos from it. Only widens the generated CSP's img-src and
# connect-src; unset, those images are blocked on any host honouring the policy.
VITE_STORAGE_ORIGIN=https://raghu-nucleus.s3.ap-south-1.amazonaws.com

# Sub-path the app is served from, with both slashes. `/` = root hosting.
BASE_PATH=/
