# Backend base URL. Unset = use the Vite dev-server proxy at /api.
# VITE_API_URL=https://api.example.com

# Google OIDC client ID (Web application type). Must match the value of
# GOOGLE_ADMIN_OIDC_CLIENT_ID on the server. Leave blank to hide the
# "Continue with Google" button on the login page.
VITE_GOOGLE_OIDC_CLIENT_ID=
